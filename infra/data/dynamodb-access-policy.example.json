{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ShadowHunterDynamoDataAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query",
        "dynamodb:TransactWriteItems"
      ],
      "Resource": [
        "REPLACE_WITH_TABLE_ARN",
        "REPLACE_WITH_TABLE_ARN/index/GSI1"
      ]
    }
  ]
}
